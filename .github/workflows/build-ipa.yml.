```yaml
name: Build iPhone IPA
on:
  workflow_dispatch:
    inputs:
      signing:
        description: 'unsigned = IPA для последующей подписи; signed = использовать Secrets'
        type: choice
        options: [unsigned, signed]
        default: unsigned
      bundle_id:
        description: 'Bundle ID основного приложения (как в профиле Apple)'
        type: string
        default: app.dimful.vpn
        required: true
permissions:
  contents: read
concurrency:
  group: dimful-ipa-${{ github.ref }}
  cancel-in-progress: true
jobs:
  build:
    runs-on: macos-15
    timeout-minutes: 90
    env:
      BUNDLE_ID: ${{ inputs.bundle_id }}
    steps:
      - uses: actions/checkout@v4
      - name: Unpack source archive (phone upload)
        run: |
          if [[ ! -f project.yml ]]; then
            unzip -q DimfulVPN.zip -d source-archive
            cp -R source-archive/DimfulVPN/. .
          fi
      - uses: actions/setup-go@v5
        with:
          go-version: '1.25.7'
          cache: false
      - name: Toolchain
        run: |
          xcodebuild -version
          swift --version
          go version
          brew install xcodegen
      - name: Parser, routing and signing tests
        run: |
          swift test
          python3 -m unittest discover -s Tests -p 'test_*.py' -v
      - name: Generate fixtures from actual Swift configuration builder
        run: |
          mkdir -p build/fixtures
          swiftc Shared/Models.swift Shared/SubscriptionParser.swift Shared/ConfigBuilder.swift Tests/FixtureGenerator.swift -o build/generate-fixtures
          build/generate-fixtures build/fixtures
      - name: Build the real VPN core
        run: bash Scripts/build-core.sh
      - name: Validate generated configurations with the pinned core
        run: |
          cd build/sing-box
          go build -tags with_quic,with_utls,with_gvisor,with_clash_api -o ../sing-box-check ./cmd/sing-box
          cd ../..
          for config in build/fixtures/*.json; do build/sing-box-check check -c "$config"; done
      - name: Build unsigned IPA
        if: inputs.signing == 'unsigned'
        run: bash Scripts/build-ipa.sh unsigned
      - name: Build signed IPA
        if: inputs.signing == 'signed'
        env:
          CERT_P12_BASE64: ${{ secrets.CERT_P12_BASE64 }}
          CERT_P12_PASSWORD: ${{ secrets.CERT_P12_PASSWORD }}
          APP_PROFILE_BASE64: ${{ secrets.APP_PROFILE_BASE64 }}
          TUNNEL_PROFILE_BASE64: ${{ secrets.TUNNEL_PROFILE_BASE64 }}
        run: bash Scripts/build-ipa.sh signed
      - name: Downloadable IPA
        uses: actions/upload-artifact@v4
        with:
          name: DimfulVPN-${{ inputs.signing }}
          path: |
            build/DimfulVPN-*.ipa
            build/DimfulVPN-*.sha256
          if-no-files-found: error
          retention-days: 7
```
